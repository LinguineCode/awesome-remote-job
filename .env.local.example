# AWS credentials (for local development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB table names
PROFILES_TABLE=carfinder-profiles-production
SEARCHES_TABLE=carfinder-search-profiles-production
LISTINGS_TABLE=carfinder-listings-production
RESULTS_TABLE=carfinder-search-results-production
NOTIF_LOG_TABLE=carfinder-notification-log-production

# Serper.dev (Google search)
SERPER_API_KEY=your-serper-api-key

# Firecrawl (AI web scraping)
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# OpenAI (AI filtering)
OPENAI_API_KEY=sk-your-openai-key

# Auth
JWT_SECRET=your-random-secret-at-least-32-chars

# Email (SES)
SES_FROM_EMAIL=notifications@carfinder.app

# Frontend URL
FRONTEND_URL=https://your-cloudfront-url.cloudfront.net
